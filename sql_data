-- Orders table
CREATE TABLE orders (
    order_id INT AUTO_INCREMENT PRIMARY KEY,
    cust_id INT,
    prd_id INT,
    quantity INT,
    order_date DATETIME DEFAULT NOW(),
    FOREIGN KEY (cust_id) REFERENCES cust_details(cust_id),
    FOREIGN KEY (prd_id) REFERENCES products(prd_id)
);
