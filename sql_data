-- Product table
CREATE TABLE products (
    prd_id INT AUTO_INCREMENT PRIMARY KEY,
    prd_name VARCHAR(25),
    price INT,
    total_stock INT DEFAULT 0,
    sold_stock INT DEFAULT 0
);

