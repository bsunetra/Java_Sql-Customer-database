CREATE DATABASE billing_details;
USE billing_details;

-- Customer table
CREATE TABLE cust_details (
    cust_id INT PRIMARY KEY,
    cust_name VARCHAR(25),
    ph_no BIGINT,
    location VARCHAR(25)
);

